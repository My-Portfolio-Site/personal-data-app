{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "personal",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-03-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "keep_names": false,
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "personal.keshab.co.in",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "personal-data-db",
      "database_id": "425783a5-402e-4959-b82e-d7f0abe23a93",
      "preview_database_id": "2d4ca79d-b6e2-4b7c-81ed-cc478e1c1dbb"
    }
  ],
  // "kv_namespaces": [
  //   {
  //     "binding": "NEXT_INC_CACHE_KV",
  //     "id": "96460dc667074bf7a3aad856fcd2de33"
  //   }
  // ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "personal"
    }
  ],
  "unsafe": {
    "bindings": [
      {
        "name": "MY_RATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1001",
        "simple": {
          "limit": 100,
          "period": 60
        }
      }
    ]
  }
}

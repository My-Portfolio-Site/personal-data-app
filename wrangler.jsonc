{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "personal",
	"main": ".open-next/worker.js",
	"compatibility_date": "2025-03-01",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"binding": "ASSETS",
		"directory": ".open-next/assets"
	},
	"observability": {
		"enabled": true
	},
	"routes": [
    {
      "pattern": "personal.keshab.co.in",
      "custom_domain": true
    }
  ],
	"vars": {
		"TEST_VAR": "test_value",
	}
}
